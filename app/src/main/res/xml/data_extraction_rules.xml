<?xml version="1.0" encoding="utf-8"?>
<!-- All personal tracking data lives only in the on-device encrypted database.
     No cloud backup or device-to-device transfer is allowed for the MVP. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
