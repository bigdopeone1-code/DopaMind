<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Used by the Voice-to-Log assistant (on-device SpeechRecognizer only) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Used by the Label & Food scanners (on-device ML Kit only) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Local-only reminders: daily check-in nudge and craving-pattern alerts -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required on Android 11+ package-visibility rules so SpeechRecognizer can
         see an installed recognition service; without this, isRecognitionAvailable()
         and startListening() silently fail even when a recognizer is present. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".DopaMindApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DopaMind"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.DopaMind"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
